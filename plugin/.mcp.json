{
  "mcpServers": {
    "gdrive": {
      "command": "uv",
      "args": ["run", "--quiet", "--frozen", "--no-dev", "--project", "${CLAUDE_PLUGIN_ROOT}", "gdrive-reader-mcp"],
      "env": {
        "UV_PROJECT_ENVIRONMENT": "${CLAUDE_PLUGIN_DATA}/venv",
        "GDRIVE_READER_DATA_DIR": "${CLAUDE_PLUGIN_DATA}"
      }
    }
  }
}
